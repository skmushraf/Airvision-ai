# =============================================================================
# AirVision AI — root .gitignore
# =============================================================================

# --- Secrets (NEVER commit) -------------------------------------------------
**/.env
.env
.env.local
.env.*.local
*.pem

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node -------------------------------------------------------------------
node_modules/
dist/
build/
.vite/
npm-debug.log*

# --- Databases --------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- ML artifacts (model is regenerated by ml/train.py) ----------------------
# Uncomment if you prefer not to commit the trained model:
# models/*.pkl
# models/*.json
